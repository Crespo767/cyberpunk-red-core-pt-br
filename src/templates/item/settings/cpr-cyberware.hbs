{{#if editable}}
<li class="item flexrow"><div class="setting-name">{{localize "CPR.prerequisites.types"}}</div><div class="setting-value">
  {{#each prerequisiteTypes}}<label><input type="checkbox" data-prerequisite-type="{{value}}" {{#if checked}}checked{{/if}}/> {{localize label}}</label>{{/each}}
</div></li>
<li class="item flexrow"><label class="setting-name" for="prereq-paired">{{localize "CPR.prerequisites.pairedLabel"}}</label><div class="setting-value"><input id="prereq-paired" type="checkbox" name="system.prerequisites.paired" {{#if item.system.prerequisites.paired}}checked{{/if}}/></div></li>
<li class="item flexrow"><div class="setting-name">{{localize "CPR.prerequisites.minBody"}}</div><div class="setting-value"><input type="number" min="0" name="system.prerequisites.minBody" value="{{item.system.prerequisites.minBody}}"/></div></li>
<li class="item flexrow"><div class="setting-name">{{localize "CPR.prerequisites.hostLabel"}}</div><div class="setting-value"><select name="system.prerequisites.host"><option value="" {{#unless item.system.prerequisites.host}}selected{{/unless}}>{{localize "CPR.prerequisites.any"}}</option><option value="IJarQGKk5rPayoLT" {{#if item.system.prerequisites.host}}selected{{/if}}>{{localize "CPR.prerequisites.socket"}}</option></select></div></li>
<li class="item flexrow prerequisite-drop"><div class="setting-name">{{localize "CPR.prerequisites.items"}}<br/>{{localize "CPR.prerequisites.drop"}}</div><div class="setting-value">
  {{#each item.system.prerequisites.cyberware}}<div><input class="prerequisite-entry" data-index="{{@index}}" data-field="name" type="text" value="{{name}}"/><input class="prerequisite-entry" data-index="{{@index}}" data-field="count" type="number" min="1" value="{{count}}"/><button type="button" class="prerequisite-remove" data-index="{{@index}}">{{localize "CPR.prerequisites.remove"}}</button></div>{{/each}}
  <button type="button" class="prerequisite-add">{{localize "CPR.prerequisites.add"}}</button>
</div></li>
{{else}}
<li class="item flexrow"><div class="setting-name">{{localize "CPR.prerequisites.label"}}</div><div class="setting-value">{{item.system.prerequisiteSummary}}</div></li>
{{/if}}
{{#if isSkillChip}}
<li class="item flexrow"><div class="setting-name">{{localize "CPR.prerequisites.chippedSkill"}}</div><div class="setting-value">{{#if editable}}<select name="system.chippedSkill"><option value=""></option>{{selectOptions chippedSkills selected=item.system.chippedSkill}}</select>{{else}}{{chippedSkillLabel}}{{/if}}</div></li>
{{/if}}
{{!-- Cyberware Item Setting --}}
{{!-- Type Setting --}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.global.generic.type"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable }}
      <select name="system.type" data-dtype="{{item.system.type}}">
        {{selectOptions (cprFindConfigObj "cyberwareTypes") selected=item.system.type localize=true}}
      </select>
    {{else}}
      <span class="text-flex-end">{{localize (cprFindConfigValue "cyberwareTypes" item.system.type)}}</span>
    {{/if}}
  </div>
</li>
{{!-- Install Location Settings --}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.global.generic.install"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable }}
      <select name="system.installLocation" data-dtype="{{item.system.installLocation}}">
        {{selectOptions (cprFindConfigObj "cyberwareInstallList") selected=item.system.installLocation localize=true}}
      </select>
    {{else}}
      <span class="text-flex-end">{{localize (cprFindConfigValue "cyberwareInstallList" item.system.installLocation)}}</span>
    {{/if}}
  </div>
</li>
{{!- Static Humanity Loss Settings --}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.dialog.installCyberware.static"}} {{localize "CPR.dialog.installCyberware.humanityLoss"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable }}
      <input name="system.humanityLoss.static"
             type="text"
             value="{{item.system.humanityLoss.static}}"/>
    {{else}}
      <span class="text-flex-end">{{item.system.humanityLoss.static}}</span>
    {{/if}}
  </div>
</li>
{{!- Rolled Humanity Loss Settings --}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.itemSheet.cyberware.rolled"}} {{localize "CPR.dialog.installCyberware.humanityLoss"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable }}
      <input name="system.humanityLoss.roll"
             type="text"
             value="{{item.system.humanityLoss.roll}}"/>
    {{else}}
      <span class="text-flex-end">{{item.system.humanityLoss.roll}}</span>
    {{/if}}
  </div>
</li>
{{!-- Requires Foundational Settings--}}
{{#unless (cprListContains "fashionware,cyberwareExternal" item.system.type)}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.itemSheet.cyberware.requiresFoundational"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable }}
      {{#if item.system.isFoundational }}
        <a class="item-checkbox" data-target="system.isFoundational"><i class="far fa-circle"></i></a>
      {{else}}
        <a class="item-checkbox" data-target="system.isFoundational"><i class="far fa-circle-check"></i></a>
      {{/if}}
    {{else}}
      {{#if item.system.isFoundational }}
        <i class="far fa-circle"></i>
      {{else}}
        <i class="far fa-circle-check"></i>
      {{/if}}
    {{/if}}
  </div>
</li>
{{#if item.system.isFoundational }}
  <li class="item flexrow">
    <div class="item flexrow setting-name text-nowrap">
      {{localize "CPR.itemSheet.cyberware.hasOptionSlots"}}
    </div>
    <div class="item flexrow setting-value text-nowrap item-end">
      {{#if this.editable }}
        {{#if item.system.installedItems.allowed }}
          <a class="item-checkbox" data-target="system.installedItems.allowed"><i class="far fa-circle-check"></i></a>
        {{else}}
          <a class="item-checkbox" data-target="system.installedItems.allowed"><i class="far fa-circle"></i></a>
        {{/if}}
      {{else}}
        {{#if item.system.installedItems.allowed }}
          <i class="far fa-circle-check"></i>
        {{else}}
          <i class="far fa-circle"></i>
        {{/if}}
      {{/if}}
    </div>
  </li>
  {{#if item.system.installedItems.allowed }}
    {{!- Installation Size Settings --}}
    <li class="item flexrow">
      <div class="item flexrow setting-name text-nowrap">
        {{localize "CPR.itemSheet.cyberware.optionalSlots"}}
      </div>
      <div class="item flexrow setting-value text-nowrap item-end">
        {{#if this.editable }}
          <input name="system.installedItems.slots" type="number" value="{{item.system.installedItems.slots}}"/>
        {{else}}
          <span class="text-flex-end">{{item.system.installedItems.slots}}</span>
        {{/if}}
      </div>
    </li>
  {{/if}}
{{else}}
  <li class="item flexrow">
    <div class="item flexrow setting-name text-nowrap">
      {{localize "CPR.itemSheet.cyberware.slotSize"}}
    </div>
    <div class="item flexrow setting-value text-nowrap item-end">
      {{#if this.editable }}
        <input name="system.size" type="number" value="{{item.system.size}}"/>
      {{else}}
        <span class="text-flex-end">{{item.system.size}}</span>
      {{/if}}
    </div>
  </li>
{{/if}}
{{/unless}}
{{#unless item.system.isFoundational}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.itemSheet.cyberware.meatArmCompatible"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable}}
      <a class="item-checkbox" data-target="system.meatArmCompatible"><i class="far {{#if item.system.meatArmCompatible}}fa-circle-check{{else}}fa-circle{{/if}}"></i></a>
    {{else}}
      <i class="far {{#if item.system.meatArmCompatible}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
    {{/if}}
  </div>
</li>
{{/unless}}
{{!- Is A Weapon Settings --}}
<li class="item flexrow">
  <div class="item flexrow setting-name text-nowrap">
    {{localize "CPR.itemSheet.common.isAWeapon"}}
  </div>
  <div class="item flexrow setting-value text-nowrap item-end">
    {{#if this.editable }}
      {{#if item.system.isWeapon }}
        <a class="item-checkbox" data-target="system.isWeapon"><i class="far fa-circle-check"></i></a>
      {{else}}
        <a class="item-checkbox" data-target="system.isWeapon"><i class="far fa-circle"></i></a>
      {{/if}}
    {{else}}
      {{#if item.system.isWeapon }}
        <i class="far fa-circle-check"></i>
      {{else}}
        <i class="far fa-circle"></i>
      {{/if}}
    {{/if}}
  </div>
</li>
{{#if item.system.isWeapon }}
  {{> "systems/cyberpunk-red-core/templates/item/settings/mixin/cpr-attackable.hbs" this}}
{{/if}}
